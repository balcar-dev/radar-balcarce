node_modules/
.env
.env.local
.env*.local
reels/salida/
reels/casting/
reels/voces/
# La cortina (marca/cortina.wav) se genera sola con ffmpeg; las tipografías sí
# se suben, para que GitHub pueda armar las placas (son libres: OFL).
reels/marca/*
!reels/marca/fuentes/
panel/datos/
ingesta/salida/
web/node_modules/
web/.next/
web/.vercel/
web/out/
# public/_redirects lo escribe scripts/generar-redirects.mjs en cada build,
# a partir de portada.json: no es código, es un artefacto más, como .next/.
# vercel.json NO se ignora (ver abajo): a diferencia de _redirects, Vercel
# necesita leerlo ANTES de compilar, no le alcanza con que el build lo
# escriba — por eso se commitea junto con portada.json.
web/public/_redirects
# web/data/portada.json SÍ se versiona a propósito: es el artefacto que
# lee el sitio público. panel/datos/ (arriba) es distinto — ahí viven las
# decisiones humanas, y eso se queda en la máquina de quien corre el panel.
*.log
.claude/
reels/canvas-*.png
